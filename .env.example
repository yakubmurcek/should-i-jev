# Server-side only. Never expose to the browser.
TYPESAFE_API_KEY=

# The public origin, used for absolute og:image URLs in link previews.
# On Vercel this is inferred; set it for any other host.
NEXT_PUBLIC_SITE_URL=

# Optional. Point at a local stub to reproduce an outage against the real UI.
# JEV_ENDPOINT=http://127.0.0.1:4529

# Optional. Defaults to the pinned jev-1.13.0.
# Do not set this to an alias: the seven vetoes encode one version's jaggedness
# profile, and jev-latest would shift that profile underneath them.
# JEV_MODEL=jev-1.13.0

# Optional. Without these, caching and rate limiting fall back to process memory,
# which is fine locally and wrong in production.
KV_REST_API_URL=
KV_REST_API_TOKEN=
